# ---------------------------------------------------------------------------
# Sentinel-AI — environment configuration
# Copy to `.env` and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- LLM engine (required unless SENTINEL_OFFLINE=1) ------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Primary reasoning model — extraction, hypothesis building, falsification,
# report synthesis.
SENTINEL_MODEL_PRIMARY=claude-sonnet-4-6

# Lighter model — page classification, source triage, cheap boolean calls.
# Tiered-model strategy is the cost mitigation described in the technical report.
SENTINEL_MODEL_LIGHT=claude-haiku-4-5

# --- Web search (Agent 2) ---------------------------------------------------
# https://app.tavily.com  — without this, Agent 2 falls back to offline fixtures.
TAVILY_API_KEY=tvly-...

# --- Runtime ----------------------------------------------------------------
# 1 = no network calls at all. Uses bundled fixtures + a deterministic stub LLM.
# Use this for the competition demo when connectivity is not guaranteed.
SENTINEL_OFFLINE=0

# SQLite database (MVP). Upgrade path: postgresql://user:pass@host/sentinel
SENTINEL_DB_PATH=data/sentinel.db

# Where downloaded / uploaded filings are stored
SENTINEL_DOC_DIR=data/documents

# Chroma persistence directory for the retrieval index
SENTINEL_INDEX_DIR=data/index

# Where generated reports are written
SENTINEL_REPORT_DIR=data/reports

# --- Verification thresholds ------------------------------------------------
# Relative tolerance for arithmetic identity checks (rounding in published
# statements is normal; 0.5% absorbs it without hiding real breaks).
SENTINEL_VERIFY_REL_TOLERANCE=0.005
# Absolute floor, in the document's reporting unit, for tiny-number comparisons.
SENTINEL_VERIFY_ABS_TOLERANCE=2

# Max re-read attempts before a metric is declared unextractable
SENTINEL_MAX_EXTRACTION_ATTEMPTS=3

# --- Reporting thresholds ---------------------------------------------------
# Findings below this confidence are suppressed from the executive summary.
# Calibration lever from the risk table: too low = false alarms, too high =
# missed signals.
SENTINEL_MIN_CONFIDENCE=0.55

# --- Scheduler --------------------------------------------------------------
# Cron expression for the autonomous monitoring cycle (server local time).
SENTINEL_MONITOR_CRON=0 3 * * *
# Comma-separated tickers under continuous watch
SENTINEL_WATCHLIST=GOTO,BUMI,TLKM
